# HINWEIS: .gitignore verhindert nur Commits, NICHT das Lesen durch Tools/Agenten.

# Umgebung
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Quell-PDFs (vertraulich, nicht committen)
Quellen und interne Dokumentation/sources/*.pdf

# Daten und Outputs
data/
raw/
Baseline Analyse Rechnungen/*
!Baseline Analyse Rechnungen/README.md
!Baseline Analyse Rechnungen/Rechenkern/
!Baseline Analyse Rechnungen/Notebooks_Archiv/
*.xlsx
*.xls
*.parquet
*.csv
# Ausnahme: ausdrücklich künstliche Fixtures
!tests/fixtures/**/*.csv
# Ausnahme: öffentliche Referenzdaten (keine Clubdaten)
!config/reference/*.csv

# Lokale Konfiguration und Geheimnisse
config/*.local.yaml
.env
*.env
secrets*

# Editor/OS
.DS_Store
Thumbs.db
.vscode/*.local.json

# Ausnahme: geteilte Analyse-Läufe (aggregierte echte Ergebnisse, privates Repo, D-024)
!Baseline Analyse Rechnungen/run*_*/
!Baseline Analyse Rechnungen/run*_*/**

# Ralfs Rechenkern (Baseline Analyse Rechnungen/Rechenkern/): öffentliche Zusatzdaten und belegte Korrekturen versionieren (D-028, D-031)
!Baseline Analyse Rechnungen/Rechenkern/external/*.csv
!Baseline Analyse Rechnungen/Rechenkern/overrides/*.csv

# Kuratierte externe Review-Excel und Diagrammdaten (private Projektablage, D-042)
!Deliverables/**/*.xlsx
!Deliverables/**/*.csv
# Standard-Ausgabeordner von Baseline Analyse Rechnungen/Rechenkern/run_all.py (Läufe stattdessen mit --ausgabe nach Baseline Analyse Rechnungen/runN_…)
Ergebnisse_Phase1/
Ergebnisse_Ideen_Grundlage/
# lokale Kopie des Übergabe-ZIPs
FCSG_Uebergabe_*/

# Spielrechner mit echten Werten (D-047) nie versionieren
*Spielrechner*.html
